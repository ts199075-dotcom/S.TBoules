    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Lightweight Firestore health check document.",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user PII accounts; restricted to owner or admin."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Non-PII directory profiles for active members."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Authoritative admin role markers."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Startup Firestore server connection verification."
    },
    "/academic_terms/{termId}": {
      "schema": { "$ref": "#/entities/AcademicTerm" },
      "description": "School academic semesters."
    },
    "/class_assigned_books/{docId}": {
      "schema": { "$ref": "#/entities/ClassAssignedBook" },
      "description": "Biblical book assignments per class and term."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/BibleSession" },
      "description": "Bible study sessions and curriculum material (QR secret stored separately)."
    },
    "/session_qr_secrets/{sessionId}": {
      "schema": { "$ref": "#/entities/SessionQrSecret" },
      "description": "Isolated QR attendance secrets accessible only to admins and class servants."
    },
    "/grades/{gradeId}": {
      "schema": { "$ref": "#/entities/SessionGrade" },
      "description": "Student session scores and QR attendance."
    },
    "/final_exams/{studentId}": {
      "schema": { "$ref": "#/entities/FinalExamScore" },
      "description": "Final exam scores per student."
    },
    "/servant_submissions/{subId}": {
      "schema": { "$ref": "#/entities/ServantAttendanceSubmission" },
      "description": "Servant weekly preparation and attendance check-ins."
    },
    "/lesson_posts/{postId}": {
      "schema": { "$ref": "#/entities/ServantLessonPost" },
      "description": "Educational posts and handouts requiring admin approval."
    },
    "/library_books/{bookId}": {
      "schema": { "$ref": "#/entities/LibraryBook" },
      "description": "School digital reference library."
    },
    "/church_events/{eventId}": {
      "schema": { "$ref": "#/entities/ChurchEvent" },
