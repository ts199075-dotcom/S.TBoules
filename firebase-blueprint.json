        "qrSecretCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "qrActive": { "type": "boolean" },
        "expiresAtMs": { "type": "number" },
        "sessionNumber": { "type": "number" },
        "bookId": { "type": "string", "maxLength": 128 },
        "bookName": { "type": "string", "maxLength": 150 },
        "testament": { "type": "string", "enum": ["old", "new"] },
        "coveredChapters": { "type": "string", "maxLength": 200 },
        "objective": { "type": "string", "maxLength": 1000 },
        "memoryVerse": { "type": "string", "maxLength": 1000 },
        "memoryVerseRef": { "type": "string", "maxLength": 200 },
        "memoryVerses": { "type": "array" },
        "lessonSummary": { "type": "string", "maxLength": 5000 },
        "attachmentName": { "type": "string", "maxLength": 255 },
        "fileData": { "type": "string", "maxLength": 750000 },
        "fileType": { "type": "string", "maxLength": 100 },
        "fileSize": { "type": "string", "maxLength": 40 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "classId", "date", "servantName", "maxScorePerMetric", "qrActive", "createdByUid", "serverCreatedAt", "serverUpdatedAt"]
    },
    "SessionQrSecret": {
      "title": "SessionQrSecret",
      "description": "Isolated QR attendance secret and expiration timestamp; restricted to admins and class servants.",
