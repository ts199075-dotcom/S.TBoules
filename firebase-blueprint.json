      "properties": {
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "enum": ["primary_4", "primary_5", "primary_6", "prep_1", "prep_2_3", "secondary", "adults"] },
        "qrSecretCode": { "type": "string", "minLength": 4, "maxLength": 128 },
        "qrActive": { "type": "boolean" },
        "expiresAtMs": { "type": "number" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "classId", "qrSecretCode", "qrActive", "expiresAtMs", "updatedByUid", "serverCreatedAt", "serverUpdatedAt"]
    },
    "SessionGrade": {
      "title": "SessionGrade",
