{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user account and PII record stored in /users/{userId}. Only accessible by the owner or verified admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "minLength": 4, "maxLength": 30 },
        "age": { "type": "number" },
        "role": { "type": "string", "enum": ["admin", "assistant", "servant", "student"] },
        "requestedRole": { "type": "string", "enum": ["student", "servant"] },
        "status": { "type": "string", "enum": ["active", "pending", "rejected", "suspended"] },
        "classId": { "type": "string", "enum": ["primary_4", "primary_5", "primary_6", "prep_1", "prep_2_3", "secondary", "adults"] },
        "guardianPhone": { "type": "string", "maxLength": 30 },
        "confessionFather": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "avatar": { "type": "string", "maxLength": 500 },
        "registeredAt": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 1000 },
        "mergedIntoUid": { "type": "string", "maxLength": 128 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "name", "phone", "age", "role", "status", "registeredAt", "serverCreatedAt", "serverUpdatedAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII directory profile for class rosters, leaderboards, and attendance sheets.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "assistant", "servant", "student"] },
        "status": { "type": "string", "enum": ["active", "pending", "rejected", "suspended"] },
        "classId": { "type": "string", "enum": ["primary_4", "primary_5", "primary_6", "prep_1", "prep_2_3", "secondary", "adults"] },
        "age": { "type": "number" },
        "registeredAt": { "type": "string", "maxLength": 40 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "name", "role", "status", "age", "registeredAt", "serverCreatedAt", "serverUpdatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Authoritative admin membership marker.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "serverCreatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "serverCreatedAt"]
    },
    "AcademicTerm": {
      "title": "AcademicTerm",
      "description": "School semester definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "bookSubject": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "sessionsCount": { "type": "number" },
        "isCurrent": { "type": "boolean" },
