      "required": ["id", "sessionId", "sessionTitle", "date", "studentId", "exam", "homework", "attendance", "participation", "prayer", "tools", "updatedByUid", "serverCreatedAt", "serverUpdatedAt"]
    },
    "FinalExamScore": {
      "title": "FinalExamScore",
      "description": "Student final exam score out of 40.",
