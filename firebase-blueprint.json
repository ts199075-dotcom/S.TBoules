        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "enum": ["primary_4", "primary_5", "primary_6", "prep_1", "prep_2_3", "secondary", "adults"] },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bookName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "testament": { "type": "string", "enum": ["old", "new"] },
        "termId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assignedByServantName": { "type": "string", "maxLength": 150 },
        "assignedAt": { "type": "string", "maxLength": 40 },
        "targetSessionsCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "customOverview": { "type": "string", "maxLength": 3000 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "bookId", "bookName", "testament", "termId", "updatedByUid", "serverCreatedAt", "serverUpdatedAt"]
    },
    "BibleSession": {
      "title": "BibleSession",
      "description": "Class Bible study session with optional curriculum handout and QR code.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "classId": { "type": "string", "enum": ["primary_4", "primary_5", "primary_6", "prep_1", "prep_2_3", "secondary", "adults"] },
        "termId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "minLength": 1, "maxLength": 40 },
        "biblePassage": { "type": "string", "maxLength": 300 },
